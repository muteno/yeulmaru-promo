#!/bin/sh
# 디자인 기틀 커밋 게이트 (3층 방어의 최종층, 260703)
# index.html·signage 편집이 baseline을 위반한 채 커밋되는 걸 차단.
# 활성화: git config core.hooksPath .githooks  (.claude/hooks/design_digest.py가 세션 시작 시 자동 수행)
ROOT="$(git rev-parse --show-toplevel)"
if [ -f "$ROOT/tools/check_design.py" ]; then
  python3 "$ROOT/tools/check_design.py" || {
    echo "[pre-commit] 디자인 기틀 위반 — 커밋 차단. 위 출력을 보고 수정하거나, 정당한 변경이면 baseline 갱신(사유 주석)." >&2
    exit 1
  }
fi
# 라우터·지침 경로 참조 게이트 (마스터 라우터 기틀)
if [ -f "$ROOT/tools/check_refs.py" ]; then
  python3 "$ROOT/tools/check_refs.py" || {
    echo "[pre-commit] check_refs 위반 — CLAUDE.md·docs/앱지침.md의 백틱 경로가 레포에 없음. 경로 수정 또는 파일 생성 후 커밋." >&2
    exit 1
  }
fi
# 배선 게이트 (Q39 260803) — 노뮤트 이식 기능(입력칸 클립·동기화 생명선) 골격·면제표·SW 우회 계약 실존
if [ -f "$ROOT/tools/check_wiring.py" ]; then
  python3 "$ROOT/tools/check_wiring.py" || {
    echo "[pre-commit] check_wiring 위반 — 클립/싱크 배선 골격 파손. 위 출력의 소실 리터럴을 복원한 뒤 커밋." >&2
    exit 1
  }
fi
# 축 중략(≈) 발동 계약 게이트 (260806 운영자 「차이가 심하면 항상 켜지게 정본에 박아라」)
# 잡는 것 = 판정이 조용히 꺼지는 것(260804~260806 실사고) · 고른 분포를 접는 오발동 · map 계약(본체는 실값=실높이) 파손.
# 정본 함수를 index.html에서 잘라 그대로 재판정한다(규칙 사본 0 · 네트워크·LLM·렌더 0 · 계약 = docs/디자인기틀.md §2 #16).
if [ -f "$ROOT/tools/check_break_rule.py" ]; then
  python3 "$ROOT/tools/check_break_rule.py" || {
    echo "[pre-commit] 축 중략 발동 계약 위반 — 커밋 차단. 위 출력의 케이스를 보고 _bizBarBreak 판정을 되돌려라." >&2
    exit 1
  }
fi
# 모달 머리줄 정본 게이트 (260805-23 운영자 「모든 모달 창 윗부분을 저거로 … 항상 저 형식」)
# 잡는 것 = 머리줄 없는 모달 · 밴드 인라인 재타이핑 · 셸 인라인 padding(음수 마진 상쇄 파손). 네트워크 0·하드 0.
if [ -f "$ROOT/tools/check_modal_head.py" ]; then
  python3 "$ROOT/tools/check_modal_head.py" || {
    echo "[pre-commit] 모달 머리줄 정본 위반 — 커밋 차단. 위 출력의 자리에 _mhead(제목, 부제)를 넣어라." >&2
    exit 1
  }
fi

if [ -f "$ROOT/tools/check_exchart.py" ]; then
  python3 "$ROOT/tools/check_exchart.py" || {
    echo "[pre-commit] check_exchart 위반 — 기틀 §2 #16 판매 추이 차트 정본 파손(스택 hvh·tozeroy 금지·보조 알파·점 배열·라벨 임계/뒤집기). 위 출력대로 복원 후 커밋." >&2
    exit 1
  }
fi
# 연간 실적(_YR) 정합 게이트 (260804) — index.html 변경 시만.
# 잡는 것 = 연도 열은 늘렸는데 누계(sum)·계·grand를 안 고친 자리(260804 실사고: 2026 열은 있는데 누계는 ~2025 그대로 ·
# 화면상 무증상이라 운영자가 눈으로 잡아냈다). 값 판단은 안 한다 — 파생값 산수만 본다(네트워크·LLM 0).
if [ -f "$ROOT/tools/build_annual_yr.mjs" ] && command -v node >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -q '^index\.html$'; then
    node "$ROOT/tools/build_annual_yr.mjs" || {
      echo "[pre-commit] _YR 정합 위반 — 연간 실적 누계·계·grand가 값과 안 맞음. 'node tools/build_annual_yr.mjs --recalc' 후 커밋." >&2
      exit 1
    }
  fi
fi
# 로그인 스모크 게이트 (index.html 변경 시만 실행 · 회귀 발생기=23k 단일파일 로그인흐름 차단)
# fail-soft: node·playwright-core·chromium 미탐지 = 스크립트가 SKIP(차단 안 함). 진짜 로그인 파손만 exit 1.
if [ -f "$ROOT/tools/smoke_login.mjs" ] && command -v node >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -q '^index\.html$'; then
    node "$ROOT/tools/smoke_login.mjs" || {
      echo "[pre-commit] 로그인 스모크 실패 — 로그인 화면 미렌더 또는 JS 회귀 감지. 위 출력 확인·수정(정말 무관하면 git commit --no-verify)." >&2
      exit 1
    }
  fi
fi
# 레이아웃(이젤·흰 라인) 스모크 게이트 — 운영자 260802f 「항상 '후'와 같게 고정」
# 좌·우 유리 블러 박스 상·하단선 Δ0 + 그 안 마지막 흰 도형 하단선 Δ0(박스 안선 밀착) + 재계산 무흔들림을 커밋 전에 실측.
# fail-soft: playwright-core·chromium 미탐지 = SKIP(차단 안 함). 정렬 파손만 exit 1.
if [ -f "$ROOT/tools/smoke_layout.mjs" ] && command -v node >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -q '^index\.html$'; then
    node "$ROOT/tools/smoke_layout.mjs" || {
      echo "[pre-commit] 레이아웃 스모크 실패 — 대시보드 블러 박스·흰 카드 하단선이 어긋남. 위 출력의 Δ를 0으로 되돌린 뒤 커밋(정말 의도된 변경이면 git commit --no-verify)." >&2
      exit 1
    }
  fi
fi
# 모달 머리줄 패리티 스모크 — 운영자 260805-23 「스모킹 패리티 고정」
# 실제로 그려진 밴드의 computed style이 모달끼리 같은지 실측(정적 게이트가 못 보는 축 = 이스케이프 파손·CSS 덮어쓰기).
# fail-soft: playwright-core·chromium 미탐지 = SKIP. 패리티 파손만 exit 1.
if [ -f "$ROOT/tools/smoke_modal_head.mjs" ] && command -v node >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -q '^index\.html$'; then
    node "$ROOT/tools/smoke_modal_head.mjs" || {
      echo "[pre-commit] 모달 머리줄 패리티 스모크 실패 — 머리줄이 모달마다 달라졌다. 위 출력의 그룹을 하나로 되돌린 뒤 커밋." >&2
      exit 1
    }
  fi
fi
# 정본 컴포넌트 패리티 래칫 — 260805-24(모달 머리줄 스모크 방법을 기틀 §2 컴포넌트 전체로 복제)
# 계약 = 「클래스가 같으면 픽셀도 같아야 한다」. baseline보다 갈래가 늘면 차단(줄면 통과+권장 안내).
# fail-soft: playwright-core·chromium 미탐지 = SKIP. 약 30초 소요(index.html 스테이징 시만).
if [ -f "$ROOT/tools/smoke_component_parity.mjs" ] && command -v node >/dev/null 2>&1; then
  if git diff --cached --name-only | grep -q '^index\.html$'; then
    node "$ROOT/tools/smoke_component_parity.mjs" || {
      echo "[pre-commit] 정본 컴포넌트 패리티 악화 — 그 자리에서 인라인으로 다시 튜닝하지 말고 정본 CSS를 고쳐라." >&2
      echo "             값을 새로 정해야 하면 운영자에게 물어라(기틀 규칙 3). 목록 = docs/reports/260805_컴포넌트_패리티_실측.md" >&2
      exit 1
    }
  fi
fi
exit 0
